{
  "name": "bun-secure-env",
  "version": "0.1.0",
  "description": "Production-grade encrypted environment loader with Zod validation, native AES-256-GCM, and profile merging for Bun.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun && bun x tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BronzonTech-Cloud/bun-secure-env.git"
  },
  "bugs": {
    "url": "https://github.com/BronzonTech-Cloud/bun-secure-env/issues"
  },
  "homepage": "https://github.com/BronzonTech-Cloud/bun-secure-env#readme",
  "keywords": [
    "bun",
    "env",
    "secure",
    "encrypted",
    "aes-256-gcm",
    "zod",
    "validation",
    "environment-variables"
  ],
  "author": "Charles Bronzon - BronzonTech-Cloud",
  "license": "MIT"
}
